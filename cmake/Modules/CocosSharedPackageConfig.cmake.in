# This is a build-tree package for a matching Windows x64 C++20 consumer.
if(TARGET CocosX::cocos2d)
    return()
endif()
string(TOLOWER "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}" _cocos_package_arch)
if(NOT (WIN32 AND MSVC AND CMAKE_SIZEOF_VOID_P EQUAL 8 AND _cocos_package_arch STREQUAL "x64"))
    message(FATAL_ERROR
        "This CocosX package requires a Windows x64 MSVC consumer; detected system '${CMAKE_SYSTEM_NAME}', compiler '${CMAKE_CXX_COMPILER_ID}', architecture '${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}'")
endif()
unset(_cocos_package_arch)
if(NOT DEFINED CocosX_CONFIGURATION)
    if(CMAKE_BUILD_TYPE)
        set(CocosX_CONFIGURATION "${CMAKE_BUILD_TYPE}")
    else()
        set(CocosX_CONFIGURATION Debug)
    endif()
endif()
set(_cocos_package_config "${CMAKE_CURRENT_LIST_DIR}/CocosX-${CocosX_CONFIGURATION}.cmake")
if(NOT EXISTS "${_cocos_package_config}")
    message(FATAL_ERROR "CocosX has no generated ${CocosX_CONFIGURATION} configuration: ${_cocos_package_config}")
endif()
include("${_cocos_package_config}")
unset(_cocos_package_config)
